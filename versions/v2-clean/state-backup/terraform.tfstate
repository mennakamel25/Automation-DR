":\"Wait_db\",\"Type\":\"Choice\"},\"Done_web\":{\"Choices\":[{\"BooleanEquals\":true,\"Next\":\"Abort\",\"Variable\":\"$.chk_web.failed\"},{\"BooleanEquals\":true,\"Next\":\"Validate_web\",\"Variable\":\"$.chk_web.done\"}],\"Default\":\"Wait_web\",\"Type\":\"Choice\"},\"E2E\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"Abort\",\"ResultPath\":\"$.error\"}],\"Next\":\"SwitchDNS\",\"Parameters\":{\"action\":\"validate_e2e\"},\"Resource\":\"arn:aws:lambda:ap-south-1:897192298286:function:crp-dr-actions\",\"ResultPath\":\"$.e2e\",\"Retry\":[{\"BackoffRate\":1,\"ErrorEquals\":[\"ValidationFailed\"],\"IntervalSeconds\":20,\"MaxAttempts\":15},{\"BackoffRate\":2,\"ErrorEquals\":[\"Lambda.ServiceException\",\"Lambda.AWSLambdaException\",\"Lambda.SdkClientException\",\"Lambda.TooManyRequestsException\"],\"IntervalSeconds\":2,\"MaxAttempts\":3}],\"Type\":\"Task\"},\"Failed\":{\"Cause\":\"See DynamoDB last_error and the execution history; the DR origin was NOT enabled.\",\"Error\":\"FailoverFailed\",\"Type\":\"Fail\"},\"Fence\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"Start_db\",\"ResultPath\":\"$.fence_error\"}],\"Next\":\"Start_db\",\"Parameters\":{\"action\":\"fence_primary\"},\"Resource\":\"arn:aws:lambda:ap-south-1:897192298286:function:crp-dr-actions\",\"ResultPath\":\"$.fence\",\"TimeoutSeconds\":170,\"Type\":\"Task\"},\"FenceChoice\":{\"Choices\":[{\"And\":[{\"IsPresent\":true,\"Variable\":\"$.drill\"},{\"BooleanEquals\":true,\"Variable\":\"$.drill\"}],\"Next\":\"Start_db\"}],\"Default\":\"Fence\",\"Type\":\"Choice\"},\"Finalize\":{\"End\":true,\"Parameters\":{\"action\":\"finalize\",\"ctx.$\":\"$\",\"execution.$\":\"$$.Execution.Name\"},\"Resource\":\"arn:aws:lambda:ap-south-1:897192298286:function:crp-dr-actions\",\"ResultPath\":\"$.final\",\"Retry\":[{\"BackoffRate\":2,\"ErrorEquals\":[\"Lambda.ServiceException\",\"Lambda.AWSLambdaException\",\"Lambda.SdkClientException\",\"Lambda.TooManyRequestsException\"],\"IntervalSeconds\":2,\"MaxAtt