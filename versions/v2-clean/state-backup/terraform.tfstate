            "definition": "{\"Comment\":\"Controlled failback DR region -\\u003e primary region. Re-protect and sync the DR instances back to the primary region BEFORE starting this (see docs/runbooks.md).\",\"StartAt\":\"Precheck\",\"States\":{\"Approval\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"FailbackFailed\",\"ResultPath\":\"$.error\"}],\"Next\":\"SwitchDNS\",\"Parameters\":{\"FunctionName\":\"arn:aws:lambda:ap-south-1:897192298286:function:crp-dr-actions\",\"Payload\":{\"action\":\"request_approval\",\"ctx.$\":\"$\",\"execution.$\":\"$$.Execution.Name\",\"kind\":\"failback\",\"token.$\":\"$$.Task.Token\"}},\"Resource\":\"arn:aws:states:::lambda:invoke.waitForTaskToken\",\"ResultPath\":\"$.approval\",\"TimeoutSeconds\":86400,\"Type\":\"Task\"},\"FailbackFailed\":{\"Cause\":\"Failback stopped; production stays in the DR region. See the execution history.\",\"Error\":\"FailbackFailed\",\"Type\":\"Fail\"},\"Finalize\":{\"End\":true,\"Parameters\":{\"action\":\"failback_finalize\"},\"Resource\":\"arn:aws:lambda:ap-south-1:897192298286:function:crp-dr-actions\",\"ResultPath\":\"$.final\",\"Type\":\"Task\"},\"Precheck\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"FailbackFailed\",\"ResultPath\":\"$.error\"}],\"Next\":\"Approval\",\"Parameters\":{\"action\":\"failback_precheck\"},\"Resource\":\"arn:aws:lambda:ap-south-1:897192298286:function:crp-dr-actions\",\"ResultPath\":\"$.precheck\",\"Type\":\"Task\"},\"SwitchDNS\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"FailbackFailed\",\"ResultPath\":\"$.error\"}],\"Next\":\"Finalize\",\"Parameters\":{\"action\":\"switch_dns\",\"target\":\"primary\"},\"Resource\":\"arn:aws:lambda:ap-south-1:897192298286:function:crp-dr-actions\",\"ResultPath\":\"$.dns\",\"Type\":\"Task\"}}}",
