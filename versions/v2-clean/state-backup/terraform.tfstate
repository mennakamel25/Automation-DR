            "user_data": "#!/usr/bin/env bash\n# EC2 user data (first boot only). The real logic lives in the application bundle (application/host/*),\n# which Terraform stages in S3 because user data is limited to 16 KB.\nset -euo pipefail\nexec \u003e \u003e(tee -a /var/log/crp-startup.log) 2\u003e\u00261\nexport DEBIAN_FRONTEND=noninteractive\nmkdir -p /etc/crp /opt/crp/app /var/lib/crp\n\n# AWS DRS identifies a source server by its hostname: give it the stable CRP name and keep it.\nhostnamectl set-hostname crp-api-a\nprintf 'preserve_hostname: true\\n' \u003e /etc/cloud/cloud.cfg.d/99-crp-hostname.cfg\ngrep -q \" crp-api-a\" /etc/hosts || echo \"127.0.1.1 crp-api-a\" \u003e\u003e /etc/hosts\n\nif [ ! -f /var/lib/crp/bundle.done ]; then\n  apt-get update -qq\n  apt-get install -y -qq unzip curl jq awscli\n  aws s3 cp \"s3://crp-artifacts-897192298286-ap-east-1/bundle/app-87a65cebcab6c5e2adb96348e1c65bfe.zip\" /tmp/crp-bundle.zip --region ap-east-1\n  unzip -q -o /tmp/crp-bundle.zip -d /opt/crp/app\n  chmod +x /opt/crp/app/host/*.sh\n  cat \u003e /etc/crp/node.env \u003c\u003c'ENVEOF'\nCRP_ROLE=api\nCRP_NAME=crp-api-a\nCRP_DOMAIN=app.gbgcafe.click\nCRP_INTERNAL_DOMAIN=internal.gbgcafe.click\nCRP_PRIMARY_REGION=ap-east-1\nCRP_DR_REGION=ap-south-1\nCRP_INSTALL_DRS_AGENT=true\nCRP_SECRET_DB_APP=crp/db-app\nCRP_SECRET_PG_SUPER=crp/pg-super\nCRP_SECRET_PG_REPL=crp/pg-repl\nCRP_SECRET_PGBR_PASS=crp/pgbackrest-pass\nCRP_BACKUP_BUCKET=crp-backups-897192298286-ap-south-1\nCRP_BACKUP_REGION=ap-south-1\nCRP_IP_PG_A=10.10.21.10\nCRP_IP_PG_B=10.10.22.10\nCRP_IP_WITNESS=10.10.23.10\nCRP_PRIMARY_VPC_CIDR=10.10.0.0/16\nCRP_DR_VPC_CIDR=10.20.0.0/16\n\nENVEOF\n  chmod 600 /etc/crp/node.env\n  touch /var/lib/crp/bundle.done\nfi\n\nexec /opt/crp/app/host/bootstrap.sh\n",
