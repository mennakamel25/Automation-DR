# Copy to config.env and edit. config.env is git-ignored. Used by scripts/deploy.sh and scripts/dr_drill.sh
export PRIMARY_REGION="us-east-1"        # production runs here
export DR_REGION="eu-west-2"          # AWS DRS replicates here, the DR controller and the backup bucket live here
export DOMAIN="example.com"              # existing PUBLIC hosted zone in Route 53
export SUBDOMAIN="app"                   # users open app.example.com
export ACM_CERT_ARN_PRIMARY=""           # existing ACM public cert for app.example.com in PRIMARY_REGION; empty = Terraform creates one
export ACM_CERT_ARN_DR=""                # same, in DR_REGION (ACM certificates are regional); empty = Terraform creates one
export ALARM_EMAIL="you@example.com"     # DR notifications + failover approval requests
export NAME_PREFIX="crp"
# AWS credentials: use your usual profile/SSO (one account; needs EC2, VPC, ELB, ACM, Route 53, DRS, IAM, Lambda,
# Step Functions, S3, KMS, Secrets Manager, SSM, DynamoDB, SNS, CloudWatch, CloudTrail in BOTH regions).
