    {
      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "failback",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"].dr",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:states:eu-west-2:897192298286:stateMachine:crp-failback",
            "creation_date": "2026-11-07T19:34:33Z",
            "definition": "{\"Comment\":\"Controlled failback DR region -\\u003e primary region. Re-protect and sync the DR instances back to the primary region BEFORE starting this (see docs/runbooks.md).\",\"StartAt\":\"Precheck\",\"States\":{\"Approval\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"FailbackFailed\",\"ResultPath\":\"$.error\"}],\"Next\":\"SwitchDNS\",\"Parameters\":{\"FunctionName\":\"arn:aws:lambda:eu-west-2:897192298286:function:crp-dr-actions\",\"Payload\":{\"action\":\"request_approval\",\"ctx.$\":\"$\",\"execution.$\":\"$$.Execution.Name\",\"kind\":\"failback\",\"token.$\":\"$$.Task.Token\"}},\"Resource\":\"arn:aws:states:::lambda:invoke.waitForTaskToken\",\"ResultPath\":\"$.approval\",\"TimeoutSeconds\":86400,\"Type\":\"Task\"},\"FailbackFailed\":{\"Cause\":\"Failback stopped; production stays in the DR region. See the execution history.\",\"Error\":\"FailbackFailed\",\"Type\":\"Fail\"},\"Finalize\":{\"End\":true,\"Parameters\":{\"action\":\"failback_finalize\"},\"Resource\":\"arn:aws:lambda:eu-west-2:897192298286:function:crp-dr-actions\",\"ResultPath\":\"$.final\",\"Type\":\"Task\"},\"Precheck\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"FailbackFailed\",\"ResultPath\":\"$.error\"}],\"Next\":\"Approval\",\"Parameters\":{\"action\":\"failback_precheck\"},\"Resource\":\"arn:aws:lambda:eu-west-2:897192298286:function:crp-dr-actions\",\"ResultPath\":\"$.precheck\",\"Type\":\"Task\"},\"SwitchDNS\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"FailbackFailed\",\"ResultPath\":\"$.error\"}],\"Next\":\"Finalize\",\"Parameters\":{\"action\":\"switch_dns\",\"target\":\"primary\"},\"Resource\":\"arn:aws:lambda:eu-west-2:897192298286:function:crp-dr-actions\",\"ResultPath\":\"$.dns\",\"Type\":\"Task\"}}}",
            "description": "",
            "encryption_configuration": [
              {
                "kms_data_key_reuse_period_seconds": 0,
                "kms_key_id": "",
                "type": "AWS_OWNED_KEY"
              }
            ],
            "id": "arn:aws:states:eu-west-2:897192298286:stateMachine:crp-failback",
            "logging_configuration": [
              {
                "include_execution_data": true,
                "level": "ERROR",
                "log_destination": "arn:aws:logs:eu-west-2:897192298286:log-group:/aws/vendedlogs/states/crp:*"
              }
