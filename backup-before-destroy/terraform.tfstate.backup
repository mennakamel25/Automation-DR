    {
      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "failover",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"].dr",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:states:eu-west-2:897192298286:stateMachine:crp-failover",
            "creation_date": "2026-11-07T19:34:36Z",
            "definition": "{\"Comment\":\"Primary region -\\u003e DR region disaster recovery with AWS Elastic Disaster Recovery. Input: {\\\"drill\\\": false, \\\"trigger\\\": \\\"manual\\\"}\",\"StartAt\":\"NeedApproval\",\"States\":{\"Abort\":{\"Next\":\"Failed\",\"Parameters\":{\"action\":\"abort\",\"ctx.$\":\"$\"},\"Resource\":\"arn:aws:lambda:eu-west-2:897192298286:function:crp-dr-actions\",\"ResultPath\":\"$.aborted\",\"Type\":\"Task\"},\"AcquireLock\":{\"Catch\":[{\"ErrorEquals\":[\"LockHeld\"],\"Next\":\"LockHeldEnd\",\"ResultPath\":\"$.error\"},{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"Abort\",\"ResultPath\":\"$.error\"}],\"Next\":\"FenceChoice\",\"Parameters\":{\"action\":\"acquire_lock\",\"ctx.$\":\"$\",\"execution.$\":\"$$.Execution.Name\"},\"Resource\":\"arn:aws:lambda:eu-west-2:897192298286:function:crp-dr-actions\",\"ResultPath\":\"$.lock\",\"Retry\":[{\"BackoffRate\":2,\"ErrorEquals\":[\"Lambda.ServiceException\",\"Lambda.AWSLambdaException\",\"Lambda.SdkClientException\",\"Lambda.TooManyRequestsException\"],\"IntervalSeconds\":2,\"MaxAttempts\":3}],\"Type\":\"Task\"},\"AfterWeb\":{\"Choices\":[{\"And\":[{\"IsPresent\":true,\"Variable\":\"$.drill\"},{\"BooleanEquals\":true,\"Variable\":\"$.drill\"}],\"Next\":\"TerminateDrill\"}],\"Default\":\"Register\",\"Type\":\"Choice\"},\"Approval\":{\"Catch\":[{\"ErrorEquals\":[\"States.Timeout\"],\"Next\":\"Abort\",\"ResultPath\":\"$.error\"},{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"Abort\",\"ResultPath\":\"$.error\"}],\"Next\":\"AcquireLock\",\"Parameters\":{\"FunctionName\":\"arn:aws:lambda:eu-west-2:897192298286:function:crp-dr-actions\",\"Payload\":{\"action\":\"request_approval\",\"ctx.$\":\"$\",\"execution.$\":\"$$.Execution.Name\",\"kind\":\"failover\",\"token.$\":\"$$.Task.Token\"}},\"Resource\":\"arn:aws:states:::lambda:invoke.waitForTaskToken\",\"ResultPath\":\"$.approval\",\"TimeoutSeconds\":900,\"Type\":\"Task\"},\"Check_api\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"Abort\",