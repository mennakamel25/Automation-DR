[Unit]
Description=CRP FastAPI backend
After=network-online.target crp-boot.service
Wants=crp-boot.service

[Service]
User=crp
Group=crp
EnvironmentFile=/etc/crp/api.env
EnvironmentFile=/etc/crp/api-runtime.env
WorkingDirectory=/opt/crp/app/backend
ExecStart=/opt/crp/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
